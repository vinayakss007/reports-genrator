{
  "name": "reports-genrator",
  "private": true,
  "version": "0.0.0",
  "description": "Self-serve reports & dashboards builder. AI is optional, never load-bearing.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @reports/api dev",
    "dev:web": "pnpm --filter @reports/web dev"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5",
    "vitest": "2.1.4"
  }
}
